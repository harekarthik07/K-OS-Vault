# Copy this file to `.env` (same folder) and fill in your key.
# `.env` is gitignored — the key never reaches GitHub.
# The app also accepts a GEMINI_API_KEY environment variable, which wins over this file.

GEMINI_API_KEY=your_key_here

# Optional — defaults to gemini-2.5-flash
KOS_MODEL=gemini-2.5-flash
